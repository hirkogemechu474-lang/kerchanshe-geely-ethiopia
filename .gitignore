# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
.next-prod/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# env files (can opt-in for commiting if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# admin data (sensitive)
/admin-data/

# deployment packages (generated by scripts/package-deploy.ps1)
/deploy/

# uploaded files (keep directory, ignore contents except .gitkeep)
# admin/ and web/ are each their own Next.js app with their own public/uploads/,
# so this must match at any depth (** prefix), not just a repo-root public/uploads/
# — a bare "public/uploads/*" only matches at repo root because it contains a
# middle slash, which anchors it per gitignore's own rules.
**/public/uploads/*
!**/public/uploads/.gitkeep

# Python tooling artifacts unrelated to either Next.js app
/.pdf-tools/
