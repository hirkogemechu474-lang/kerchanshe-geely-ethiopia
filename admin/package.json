{
  "name": "geely-ethiopia-admin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo -p 7500",
    "dev:lan": "next dev --turbo -H 0.0.0.0 -p 7500",
    "dev:regen": "npm run db:generate && next dev --turbo -p 7500",
    "dev:regen:lan": "npm run db:generate && next dev --turbo -H 0.0.0.0 -p 7500",
    "build": "prisma generate && next build",
    "start": "next start -p 7600",
    "start:lan": "next start -H 0.0.0.0 -p 7600",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed-comprehensive.ts",
    "seed": "tsx prisma/seed-comprehensive.ts",
    "seed:all": "tsx prisma/seed-all.mjs",
    "seed:services": "tsx prisma/seed-services-menu.ts",
    "seed:electric": "tsx prisma/seed-electric-menu.ts",
    "seed:financing": "tsx prisma/seed-financing.ts",
    "seed:faq": "tsx prisma/seed-faq.ts",
    "seed:site-nav": "tsx prisma/seed-site-nav.ts",
    "seed:users": "tsx prisma/seed-users.ts",
    "seed:parts": "tsx prisma/seed-parts.ts",
    "seed:vehicle-packages": "tsx prisma/seed-vehicle-packages.ts",
    "seed:vehicle-accessories": "tsx prisma/seed-vehicle-accessories.ts",
    "seed:vehicle-colors": "tsx prisma/seed-vehicle-colors.ts",
    "seed:vehicle-wheels": "tsx prisma/seed-vehicle-wheels.ts",
    "create:admin": "tsx scripts/create-admin.ts",
    "verify": "tsx scripts/verify-seed.ts",
    "db:reset:transactional": "tsx scripts/reset-transactional-data.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "0.468.0",
    "next": "15.5.23",
    "next-auth": "4.24.15",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.6",
    "postcss": "8.5.1",
    "prisma": "^5.22.0",
    "tailwindcss": "3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "5.7.2"
  },
  "overrides": {
    "nodemailer": "^9.0.5",
    "uuid": "^11.1.1"
  }
}
