  features    Json // Array of feature strings
  price       Float
  imageUrl    String?
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vehicleId])
}

// Vehicle Interior Options
model VehicleInterior {
  id           String   @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  name         String // e.g., "Black Leather", "Beige Fabric"
  description  String?
  materialType String // e.g., "Leather", "Fabric", "Synthetic"
  imageUrl     String? // Primary/cover image — unchanged, every existing reader keeps working
  images       Json? // Additional photos from other angles/sides — additive, admin-only until a consumer reads it
