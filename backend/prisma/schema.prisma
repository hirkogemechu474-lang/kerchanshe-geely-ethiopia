  name      String // e.g., "Standard Alloy", "Sport Alloy"
  size      String // e.g., "16\"", "17\"", "18\""
  imageUrl  String? // Primary/cover image — unchanged, every existing reader keeps working
  images    Json? // Additional photos from other angles/sides — additive, admin-only until a consumer reads it
  price     Float    @default(0)
  isDefault Boolean  @default(false)
  inStock   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
