// Vehicle Packages
model VehiclePackage {
  id          String   @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  name        String // e.g., "Premium Package", "Sport Package"
