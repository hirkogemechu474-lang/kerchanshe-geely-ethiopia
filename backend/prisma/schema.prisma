// Electric Pages (Charging Map, Home Charging, Fast Charging, etc.)
model ElectricPage {
  id               String            @id @default(uuid())
  title            String
  slug             String            @unique
  pageType         String // charging-map, home-charging, fast-charging, custom
  heroTitle        String?
  heroSubtitle     String?
  heroImage        String?
  content          String?           @db.Text // Rich text content
  sections         Json? // Array of content sections
  metadata         Json? // SEO metadata, custom fields
  isPublished      Boolean           @default(false)
  displayOrder     Int               @default(0)
  createdAt        DateTime          @default(now())
