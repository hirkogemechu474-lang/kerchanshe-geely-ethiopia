  status       ContentStatus @default(PUBLISHED)
  scheduledAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// URL Redirect Management
// Manages 301/302 redirects when model slugs change or pages are retired
model Redirect {
  id         String   @id @default(uuid())
  fromPath   String   @unique // e.g. /models/old-coolray
  toPath     String // e.g. /models/coolray
  statusCode Int      @default(301) // 301 (permanent) or 302 (temporary)
  isActive   Boolean  @default(true)
  note       String? // Admin note explaining why redirect was created
  hitCount   Int      @default(0) // How many times this redirect was used
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([fromPath, isActive])
}

// ═══════════════════════════════════════════════════════════════════════════════
// FINANCING SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

// A bank / finance partner that provides vehicle loans
model FinancingBank {
  id                String             @id @default(uuid())
  name              String // e.g. "Dashen Bank"
  slug              String             @unique
  logoUrl           String?
  websiteUrl        String?
  phoneNumber       String?
  email             String?
  branchAddress     String?
  shortDescription  String? // 1-2 line elevator pitch for the partner
  isActive          Boolean            @default(true)
  displayOrder      Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  financingPrograms FinancingProgram[]

  @@index([isActive, displayOrder])
}

// A concrete financing offer (e.g. "Dashen Bank 5-Year 12.5% - Coolray")
// Frontend "Monthly Payment" is calculated dynamically from vehicle price + these fields
enum FinancingProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model FinancingProgram {
  id     String        @id @default(uuid())
  name   String // Admin-facing label e.g. "Standard 5-Year Plan"
  slug   String        @unique
  bankId String
  bank   FinancingBank @relation(fields: [bankId], references: [id], onDelete: Cascade)

  // Core loan terms (editable in admin)
  interestRate          Decimal @db.Decimal(6, 3) // annual % e.g. 12.500
  downPaymentPercent    Decimal @db.Decimal(5, 2) // % of vehicle price e.g. 20.00
  minDownPaymentPercent Decimal @default(10) @db.Decimal(5, 2)
  maxDownPaymentPercent Decimal @default(70) @db.Decimal(5, 2)
  tenureMonths          Int // e.g. 60 for 5 years
  minTenureMonths       Int     @default(12)
  maxTenureMonths       Int     @default(84)

  processingFeePercent Decimal  @default(2.5) @db.Decimal(5, 2)
  processingFeeMin     Decimal? @db.Decimal(12, 2) // floor in ETB
  processingFeeMax     Decimal? @db.Decimal(12, 2) // ceiling in ETB
  insurancePercent     Decimal  @default(5) @db.Decimal(5, 2)

  // Optionally restrict program to specific vehicle(s) or category
  vehicleId            String?
  vehicle              Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleCategoryId    String?
  vehicleCategory      VehicleCategory? @relation(fields: [vehicleCategoryId], references: [id], onDelete: SetNull)
  appliesToAllVehicles Boolean          @default(true) // when true, vehicleId/categoryId are ignored

  // Call-to-Action toggles (per-program, overrides global settings)
  applyEnabled         Boolean @default(true)
  applyUrl             String? // e.g. "https://dashenbank.com/auto-loan/apply" OR "/financing/apply?plan=xxx"
  applyLabel           String? // default: "Apply for Financing"
  directPayEnabled     Boolean @default(false)
  directPayUrl         String? // payment gateway / telebirr / bank transfer link
  directPayLabel       String? // default: "Pay Direct"
  visitShowroomEnabled Boolean @default(true)
  visitShowroomUrl     String? // default: "/dealers"
  visitShowroomLabel   String? // default: "Visit Showroom"
  scheduleEnabled      Boolean @default(true) // show/hide schedule on program card
  scheduleUrl          String? // optional: "/schedule?program=xxx"

  // Metadata
  badgeText       String? // e.g. "Most Popular", "Lowest Rate"
  highlightBadge  Boolean                @default(false)
  finePrint       String? // legal text e.g. "Terms and conditions apply"
  eligibilityNote String? // short eligibility summary
  status          FinancingProgramStatus @default(DRAFT)
  publishedAt     DateTime?
  displayOrder    Int                    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, displayOrder])
  @@index([bankId, status])
  @@index([vehicleId, status])
}

// ═══════════════════════════════════════════════════════════════════════════════
// SITE NAVIGATION (header main nav + Models mega-menu Quick Actions panel)
// ═══════════════════════════════════════════════════════════════════════════════

enum SiteNavPlacement {
  TOP_NAV
  MODELS_QUICK_ACTIONS
}

model SiteNavItem {
  id            String           @id @default(uuid())
  placement     SiteNavPlacement
  label         String
  subtitle      String? // Quick Actions only
  icon          String? // name from a fixed lucide-icon allowlist — see web/lib/navIcons.ts
  href          String
  openInNewTab  Boolean          @default(false)
  isHighlighted Boolean          @default(false) // Quick Actions: renders as the dark CTA tile
  isActive      Boolean          @default(true)
  status        ContentStatus    @default(PUBLISHED)
  scheduledAt   DateTime?
  displayOrder  Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([placement, isActive, displayOrder])
}

enum VehicleAllocationStatus {
  RESERVED
  ALLOCATED
  RELEASED
  DELIVERED
}

// Local allocation ledger prepared for a future ERP/OEM connector.
model VehicleAllocation {
  id            String                  @id @default(uuid())
  orderId       String                  @unique
  vehicleId     String
  vin           String?
  status        VehicleAllocationStatus @default(RESERVED)
  erpSystem     String?
  erpReference  String?
  allocatedAt   DateTime                @default(now())
  releasedAt    DateTime?
  allocatedById String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  order         SalesOrder              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vehicle       Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([vehicleId, status])
  @@index([vin])
}

model Warranty {
  id                String          @id @default(uuid())
  orderId           String          @unique
  order             SalesOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vin               String?
  vehicleModel      String
  customerName      String
  customerPhone     String
  customerEmail     String?
  purchaseDate      DateTime
  warrantyStartDate DateTime
  warrantyEndDate   DateTime
  warrantyYears     Int             @default(3)
  warrantyKm        Int             @default(100000)
  currentKm         Int             @default(0)
  status            String          @default("ACTIVE") // ACTIVE | EXPIRED | CLAIMED | VOID
  lastServiceDate   DateTime?
  nextServiceDate   DateTime?
  nextServiceKm     Int?
  serviceHistory    ServiceRecord[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([orderId])
  @@index([vin])
  @@index([status])
}

model ServiceRecord {
  id              String    @id @default(uuid())
  warrantyId      String
  warranty        Warranty  @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  serviceDate     DateTime
  serviceType     String // SCHEDULED | REPAIR | RECALL | INSPECTION
  description     String?   @db.Text
  kmAtService     Int?
  cost            Float?
  performedBy     String?
  nextServiceDate DateTime?
  nextServiceKm   Int?
  documents       Json? // URLs of attached documents
  createdAt       DateTime  @default(now())

  @@index([warrantyId])
  @@index([serviceDate])
}

model CustomerFollowUp {
  id                String     @id @default(uuid())
  orderId           String
  order             SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  followUpType      String // INITIAL_CHECK | SATISFACTION | LOYALTY | SERVICE_REMINDER
  scheduledDate     DateTime
  assignedTo        String?
  status            String     @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | NO_ANSWER | WRONG_NUMBER | REQUESTED_CALLBACK
  notes             String?    @db.Text
  npsScore          Int? // 0-10
  satisfactionScore Int? // 1-5
  wouldRecommend    Boolean?
  callbackDate      DateTime?
  completedAt       DateTime?
  createdAt         DateTime   @default(now())

  @@index([orderId])
  @@index([assignedTo, status])
  @@index([scheduledDate, status])
}

model CustomerNPS {
  id                String     @id @default(uuid())
  orderId           String     @unique
  order             SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  npsScore          Int // 0-10
  satisfactionScore Int? // 1-5
  wouldRecommend    Boolean?
  recordedAt        DateTime   @default(now())

  @@index([npsScore])
}

model AuditLog {
  id              String   @id @default(uuid())
  entityType      String
  entityId        String
  action          String
  performedById   String
  performedByName String?
  fromValue       Json?
  toValue         Json?
  reason          String?
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([entityType, entityId])
  @@index([performedById])
  @@index([createdAt])
  @@index([action])
}

model ComplaintCase {
  id            String          @id @default(uuid())
  caseNo        String          @unique
  customerName  String
  customerPhone String
  customerEmail String?
  orderId       String?
  vehicleModel  String?
  vin           String?
  category      String // VEHICLE_ISSUE | SERVICE_QUALITY | BILLING | STAFF_CONDUCT | DELIVERY | OTHER
  priority      String // LOW | MEDIUM | HIGH | CRITICAL
  subject       String
  description   String          @db.Text
  source        String // PHONE | EMAIL | WALK_IN | ONLINE | SOCIAL_MEDIA
  status        String          @default("OPEN") // OPEN | IN_PROGRESS | PENDING_CUSTOMER | PENDING_INTERNAL | RESOLVED | CLOSED | REOPENED
  assignedTo    String?
  resolvedAt    DateTime?
  resolvedById  String?
  closedAt      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  notes         ComplaintNote[]

  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([assignedTo])
}

model ComplaintNote {
  id        String        @id @default(uuid())
  caseId    String
  case      ComplaintCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  noteType  String // INTERNAL | CUSTOMER_COMMUNICATION | RESOLUTION
  content   String        @db.Text
  createdBy String
  isPublic  Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([caseId])
}

model UpgradeOpportunity {
  id              String           @id @default(uuid())
  opportunityNo   String           @unique
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId       String?
  vehicle         CustomerVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  opportunityType String // TRADE_IN | UPGRADE | FAMILY_ADDITION | FLEET
  targetModel     String?
  estimatedBudget Float?
  source          String // SERVICE_VISIT | FOLLOW_UP | MARKETING | SELF_REFERRAL
  status          String           @default("IDENTIFIED") // IDENTIFIED | CONTACTED | QUALIFIED | PROPOSAL | NEGOTIATION | WON | LOST | EXPIRED
  assignedTo      String?
  notes           String?          @db.Text
  // Optional link to the campaign/promotion that prompted this opportunity's
  // outreach (e.g. detectOpportunities() flagged an aging vehicle right as a
  // trade-in Promotion is running) — a light connective link, not a new
  // targeting engine; detectOpportunities()'s own age/mileage logic is
  // unchanged.
  promotionId     String?
  promotion       Promotion?       @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  wonAt           DateTime?
  wonById         String?
  lostAt          DateTime?
  lostReason      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([assignedTo])
  @@index([opportunityType])
  @@index([promotionId])
}

model SLATimer {
  id           String    @id @default(uuid())
  entityType   String
  entityId     String
  stage        String
  startTime    DateTime  @default(now())
  deadline     DateTime
  escalateAt   DateTime?
  assignedTo   String?
  status       String    @default("ACTIVE") // ACTIVE | COMPLETED | BREACHED
  completedAt  DateTime?
  minutesTaken Int?
  createdAt    DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([status, deadline])
  @@index([assignedTo, status])
}

// ─── Loyalty Program ────────────────────────────────────────────────────────
// One account per Customer (found-or-created by phone, same dedupe
// convention as every other customer lookup in this codebase — Quotation/
// CustomerVehicle etc. don't have a real customerId FK, so points are
// earned by matching on customerPhone at the two hook points: a SalesOrder
// reaching DELIVERED and a JobCard reaching RELEASED — see
// loyalty.service.ts). Tier is a plain running total threshold, recomputed
// on every earn/redeem; no time-decay/expiry modeled.
enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  VIP
}

model LoyaltyAccount {
  id           String               @id @default(uuid())
  customerId   String               @unique
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points       Int                  @default(0)
  tier         LoyaltyTier          @default(BRONZE)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transactions LoyaltyTransaction[]

  @@index([tier])
}

model LoyaltyTransaction {
  id         String         @id @default(uuid())
  accountId  String
  account    LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  points     Int // positive = earn, negative = redeem
  reason     String
  sourceType String? // 'SALES_ORDER' | 'JOB_CARD' | 'MANUAL' | 'REFERRAL'
  sourceId   String?
  createdAt  DateTime       @default(now())

  @@index([accountId])
  @@index([createdAt])
}
